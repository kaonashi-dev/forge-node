#!/usr/bin/env bash
#
# Build and distribute Forge Node as an installable app (§17, §18 Fase 9).
#
# One artifact to copy between machines. `build` produces a single tarball
# holding the packaged app plus a self-contained install.sh, so a faster
# machine can own the release build and any Mac (or Linux box) of the matching
# architecture installs the result with nothing but tar:
#
#   scripts/dist build [--universal]
#       -> dist/release/forge-<ver>-<os>-<arch>.tar.gz
#       -> also refreshes dist/macos/Forge Node.app (so a local `open` matches
#          the tarball; a stale sibling against a newer daemon sticks on
#          "connecting")
#   scripts/dist ship <user@host> [--universal | <archive.tar.gz>]
#       -> build (or reuse an existing archive), scp it, print install steps
#   scripts/dist install <archive.tar.gz> [DEST_DIR]
#       -> unpack and install on THIS machine
#   scripts/dist --help
#
# The receiving machine needs no checkout and no Rust: untar the archive and
# run the bundled install.sh. It strips the com.apple.quarantine attribute
# (AirDrop and browsers set it; scp/rsync do not), checks the bundle's slices
# against the host CPU, replaces any previous Forge Node.app in /Applications —
# falling back to ~/Applications when that is not writable — and verifies the
# code signature when one is present. A custom destination works too:
# ./install.sh "$HOME/Applications".
#
# Bundle assembly is delegated to scripts/package-macos / scripts/package-linux,
# so their knobs keep working unchanged (the macOS bundle now holds the Tauri
# GUI from apps/tauri plus the Rust forge-daemon; Linux is
# unchanged): FORGE_CODESIGN_IDENTITY /
# FORGE_ENTITLEMENTS / FORGE_NOTARY_PROFILE (signing + notarization),
# FORGE_VERSION, FORGE_BUNDLE_ID, FORGE_ICNS / FORGE_ICON_PNG,
# FORGE_MAINTAINER. This script adds exactly one:
#
#   FORGE_DIST_OUT_DIR  where the transferable archives land
#                       (default: <repo>/dist/release)
#
# Like the package-* scripts this is NEVER run automatically — not by
# `scripts/dev`, not by CI.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

# ---------------------------------------------------------------- helpers ---

die() {
  printf 'dist: %s\n' "$*" >&2
  exit 1
}

# Progress goes to stderr so `archive="$(scripts/dist build)"` yields only the
# artifact path on stdout.
note() { printf '==> %s\n' "$*" >&2; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required tool '$1' not found in PATH${2:+ — $2}"
}

print_help() {
  awk 'NR == 1 {next} !/^#/ {exit} {sub(/^# ?/, ""); print}' "$0"
}

version_of_workspace() {
  local version
  version="$(awk '/^\[workspace\.package\]/{f=1;next} /^\[/{f=0} f && /^version *=/{gsub(/[",]/,"",$3); print $3; exit}' Cargo.toml)"
  [ -n "$version" ] || die "could not determine the version — set FORGE_VERSION"
  printf '%s' "$version"
}

platform_tags() {
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64|Darwin/aarch64) printf 'macos arm64' ;;
    Darwin/x86_64)               printf 'macos x86_64' ;;
    Linux/x86_64)                printf 'linux x86_64' ;;
    Linux/arm64|Linux/aarch64)   printf 'linux arm64' ;;
    *) die "unsupported build platform: $(uname -s)/$(uname -m)" ;;
  esac
}

# ------------------------------------------------------- embedded installer --
# Emitted verbatim into every archive via a quoted heredoc (nothing expands at
# generation time, and single quotes inside stay literal). Takes an optional
# destination directory (macOS) so it can be exercised without touching
# /Applications.
write_installer() {
  local topdir="$1"
  cat >"$topdir/install.sh" <<'INSTALL_SH'
#!/usr/bin/env bash
# Installer for a Forge Node distribution archive (generated by scripts/dist).
# Usage: extract the archive anywhere, then run ./install.sh [DEST_DIR]
set -euo pipefail

die() { printf 'install.sh: %s\n' "$*" >&2; exit 1; }
note() { printf '==> %s\n' "$*"; }

contains() { case " $1 " in *" $2 "*) return 0 ;; *) return 1 ;; esac; }

here="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s)" in
  Darwin)
    # Prefer the current display-name bundle; keep Forge.app for older archives.
    if [ -d "$here/Forge Node.app" ]; then
      app="$here/Forge Node.app"
    elif [ -d "$here/Forge.app" ]; then
      app="$here/Forge.app"
    else
      die "Forge Node.app not found next to install.sh — extract the whole archive first"
    fi

    # Check the architecture of the binary macOS will actually launch, not a
    # guessed name: CFBundleExecutable is "Forge" (no spaces) while the .app
    # folder displays as "Forge Node". Older archives may still say "forge".
    plist="$app/Contents/Info.plist"
    exe=""
    if [ -f "$plist" ] && command -v plutil >/dev/null 2>&1; then
      exe="$(plutil -extract CFBundleExecutable raw -o - "$plist" 2>/dev/null || true)"
    fi
    if [ -z "$exe" ]; then
      for candidate in Forge forge; do
        if [ -x "$app/Contents/MacOS/$candidate" ]; then exe="$candidate"; break; fi
      done
    fi
    [ -n "$exe" ] || die "broken bundle: cannot determine CFBundleExecutable from $plist"
    bin="$app/Contents/MacOS/$exe"
    [ -x "$bin" ] || die "broken bundle: CFBundleExecutable is '$exe' but $bin is missing"
    [ -x "$app/Contents/MacOS/forge-daemon" ] \
      || die "broken bundle: missing $app/Contents/MacOS/forge-daemon (the GUI spawns its sibling)"

    # Refuse (or warn about) an architecture mismatch early instead of letting
    # the kernel kill the app with a cryptic "Code Signature Invalid".
    host_arch="$(uname -m)"
    archs=""
    command -v lipo >/dev/null 2>&1 && archs="$(lipo -archs "$bin" 2>/dev/null || true)"
    if [ -n "$archs" ]; then
      if [ "$host_arch" = x86_64 ] && contains "$archs" arm64 && ! contains "$archs" x86_64; then
        die "this bundle is arm64-only but this Mac is $host_arch — rebuild with: scripts/dist build --universal"
      fi
      if [ "$host_arch" = arm64 ] && contains "$archs" x86_64 && ! contains "$archs" arm64; then
        note "warning: x86_64-only bundle on Apple Silicon — Rosetta 2 required (softwareupdate --install-rosetta)"
      fi
    fi

    # scp/rsync transfers carry no quarantine attribute, AirDrop and browsers
    # do; strip it from both the staged copy and the installed one so
    # Gatekeeper never blocks a first launch of a locally built bundle.
    xattr -dr com.apple.quarantine "$app" 2>/dev/null || true

    if [ $# -ge 1 ]; then
      dest_dir="$1"
      mkdir -p "$dest_dir"
    elif [ -w /Applications ]; then
      dest_dir="/Applications"
    else
      dest_dir="$HOME/Applications"
      mkdir -p "$dest_dir"
      note "/Applications is not writable — installing to $dest_dir"
    fi
    dest="$dest_dir/Forge Node.app"
    # Drop a previous short-name install so Dock/Finder do not keep two apps.
    rm -rf "$dest_dir/Forge.app"

    rm -rf "$dest"
    # ditto preserves permissions, symlinks and extended attributes; plain cp
    # can drop them and break the signature or the executable bit.
    ditto "$app" "$dest"
    xattr -dr com.apple.quarantine "$dest" 2>/dev/null || true
    note "installed: $dest"

    if command -v codesign >/dev/null 2>&1; then
      if codesign --verify --deep --strict "$dest" 2>/dev/null; then
        note "code signature verified"
      else
        note "unsigned or ad-hoc bundle — expected for local builds; macOS will simply run it"
      fi
    fi

    note "done — launch with: open \"$dest\""
    ;;

  Linux)
    deb="$(find "$here" -maxdepth 1 -name 'forge_*.deb' | head -n1 || true)"
    img="$(find "$here" -maxdepth 1 \( -name 'ForgeNode-*.AppImage' -o -name 'Forge-*.AppImage' \) | head -n1 || true)"

    if [ -n "$deb" ]; then
      note "installing $deb (sudo required)"
      sudo dpkg -i "$deb" || note "dpkg reported problems — fix dependencies with: sudo apt-get -f install"
      note "done — launch 'forge' from your desktop launcher"
    elif [ -n "$img" ]; then
      bin_dir="$HOME/.local/bin"
      mkdir -p "$bin_dir"
      install -m 755 "$img" "$bin_dir/forge.AppImage"
      ln -sf "$bin_dir/forge.AppImage" "$bin_dir/forge"
      note "installed: $bin_dir/forge.AppImage (symlinked as $bin_dir/forge)"
      note "make sure $bin_dir is on PATH; Vulkan + Wayland/X11 runtime libraries are documented in scripts/package-linux"
    else
      die "no .deb or .AppImage found next to install.sh — extract the whole archive first"
    fi
    ;;

  *)
    die "unsupported platform: $(uname -s)"
    ;;
esac
INSTALL_SH
  chmod 755 "$topdir/install.sh"
}

# ------------------------------------------------------------------ build ---

build_archive() {
  local universal=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      --universal) universal=1 ;;
      *) die "unknown build argument '$arg' (see --help)" ;;
    esac
  done

  local tags ostag archtag
  tags="$(platform_tags)"
  read -r ostag archtag <<<"$tags"
  if [ "$universal" -eq 1 ]; then
    [ "$ostag" = macos ] || die "--universal only applies to macOS bundles"
    archtag="universal"
  fi

  local version
  version="$(version_of_workspace)"
  [ -n "${FORGE_CODESIGN_IDENTITY:-}" ] \
    && require_cmd codesign "part of the Xcode Command Line Tools"

  # Global so the EXIT trap can still see it after this function's frame is gone.
  STAGE_DIR="$(mktemp -d)"
  local stage="$STAGE_DIR"
  trap 'rm -rf "$STAGE_DIR"' EXIT

  # Delegate assembly so signing/notarization behavior lives in exactly one
  # place per platform; the packager runs the release cargo build itself.
  case "$ostag" in
    macos)
      local pkg_args=() label="scripts/package-macos"
      [ "$universal" -eq 1 ] && { pkg_args+=(--universal); label="$label, universal"; }
      note "packaging Forge Node.app (via $label)"
      # Guarded expansion keeps bash 3.2 happy about the possibly-empty array.
      FORGE_OUT_DIR="$stage/pkg" "$repo_root/scripts/package-macos" \
        ${pkg_args[@]+"${pkg_args[@]}"} >&2
      [ -d "$stage/pkg/Forge Node.app" ] || die "package-macos produced no Forge Node.app"
      ;;
    linux)
      note "packaging Linux artifacts (via scripts/package-linux all)"
      FORGE_OUT_DIR="$stage/pkg" "$repo_root/scripts/package-linux" all >&2
      ;;
  esac

  local topdir="$stage/forge-${version}-${ostag}-${archtag}"
  mkdir -p "$topdir"

  case "$ostag" in
    macos) mv "$stage/pkg/Forge Node.app" "$topdir/" ;;
    linux) mv "$stage"/pkg/*.deb "$stage"/pkg/*.AppImage "$topdir/" ;;
  esac
  write_installer "$topdir"

  local out_dir archive
  out_dir="${FORGE_DIST_OUT_DIR:-$repo_root/dist/release}"
  mkdir -p "$out_dir"
  archive="$out_dir/forge-${version}-${ostag}-${archtag}.tar.gz"

  note "packing $archive"
  # COPYFILE_DISABLE keeps bsdtar from emitting ._ AppleDouble entries that
  # pollute non-mac filesystems; tar (not zip) preserves the executable bit,
  # symlinks and the ad-hoc signature embedded in each Mach-O.
  COPYFILE_DISABLE=1 tar -czf "$archive" -C "$stage" "forge-${version}-${ostag}-${archtag}"

  # `package-macos` was pointed at the stage dir, so dist/macos/Forge Node.app
  # would otherwise stay on whatever an earlier direct package-macos left
  # behind. Opening that stale sibling against a newer daemon (or a leftover
  # target/release one) leaves the GUI on "connecting" forever — HelloReject
  # on the wire, spawn retries that cannot take the singleton lock.
  if [ "$ostag" = macos ]; then
    local local_app="$repo_root/dist/macos/Forge Node.app"
    mkdir -p "$repo_root/dist/macos"
    rm -rf "$local_app" "$repo_root/dist/macos/Forge.app"
    ditto "$topdir/Forge Node.app" "$local_app"
    xattr -dr com.apple.quarantine "$local_app" 2>/dev/null || true
    note "refreshed $local_app (for local open)"
  fi

  printf '%s' "$archive"
}

# ---------------------------------------------------------------- install ---

cmd_install() {
  [ $# -ge 1 ] || die "usage: scripts/dist install <archive.tar.gz> [DEST_DIR]"
  local archive="$1"
  shift
  [ -f "$archive" ] || die "no such archive: $archive"

  require_cmd tar
  STAGE_DIR="$(mktemp -d)"
  local stage="$STAGE_DIR"
  trap 'rm -rf "$STAGE_DIR"' EXIT

  tar -xzf "$archive" -C "$stage"
  local topdir
  topdir="$(find "$stage" -mindepth 1 -maxdepth 1 -type d | head -n1)"
  [ -n "$topdir" ] || die "archive is empty: $archive"
  [ -x "$topdir/install.sh" ] || die "archive has no install.sh — not a forge distribution archive"

  "$topdir/install.sh" "$@"
}

# ------------------------------------------------------------------- ship ---

cmd_ship() {
  [ $# -ge 1 ] || die "usage: scripts/dist ship <user@host> [--universal | <archive.tar.gz>]"
  local host="$1"
  shift

  local archive="" extra=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --universal) extra+=("$arg") ;;
      *) archive="$arg" ;;
    esac
  done

  if [ -z "$archive" ]; then
    archive="$(build_archive ${extra[@]+"${extra[@]}"})"
  elif [ ! -f "$archive" ]; then
    die "no such archive: $archive"
  fi

  require_cmd scp "part of the openssh client"
  local base root
  base="$(basename "$archive")"
  root="${base%.tar.gz}"
  note "copying $base to $host"
  scp "$archive" "$host:"

  cat <<EOS

Archive copied. Finish on $host with one command:

  ssh $host 'tar xzf $base && ./$root/install.sh'

or interactively: tar xzf $base && cd $root && ./install.sh
EOS
}

# ------------------------------------------------------------------- main ---

cmd="${1:-}"
shift 2>/dev/null || true
case "$cmd" in
  build)
    archive="$(build_archive "$@")"
    printf '%s\n' "$archive"
    note "done: $archive ($(du -h "$archive" | cut -f1))"
    note "copy it over (or use: scripts/dist ship <user@host> $archive), then on the target machine:"
    note "  tar xzf $(basename "$archive") && ./$(basename "$archive" .tar.gz)/install.sh"
    ;;
  install)  cmd_install "$@" ;;
  ship)     cmd_ship "$@" ;;
  -h|--help|help|"") print_help ;;
  *) die "unknown command '$cmd' (see --help)" ;;
esac
