#!/usr/bin/env bash
# Local development helper for Forge Node.
#
# Usage:
#   scripts/dev daemon      # build + run the daemon in the foreground (verbose logs)
#                           # isolated socket/db/config per run; the daily daemon is untouched
#   scripts/dev check       # fmt-check + clippy + test the workspace and apps/ui
#   scripts/dev check --root-only  # skip apps/ui
#   scripts/dev dump        # unwired placeholder (forge-daemon dump --json)
#   scripts/dev ui check    # fmt-check + clippy + test the Rune client (apps/ui, Rust 1.99)
#   scripts/dev ui run ...  # run the Rune client; arguments go to forge-ui
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "$(uname -s)" = Darwin ]; then
  SDKROOT="$(scripts/macos-sdk)" || {
    echo "scripts/dev: no macOS SDK the installed linker can parse" >&2
    exit 1
  }
  export SDKROOT
fi

cmd="${1:-check}"
case "$cmd" in
  daemon)
    # Isolated by default: a dev daemon gets a scratch socket and a scratch
    # Forge home under $FORGE_DEV_DIR (fresh mktemp per run unless already set),
    # so it never contends with the daily daemon's lock or wipes its tabs, and
    # its worktrees land in $FORGE_DEV_DIR/worktrees.
    # Point a dev GUI at it with the export line this prints on stderr.
    : "${FORGE_DEV_DIR:=$(mktemp -d "${TMPDIR:-/tmp}/forge-dev-XXXXXX")}"
    export FORGE_SOCKET="$FORGE_DEV_DIR/daemon.sock"
    export FORGE_HOME="$FORGE_DEV_DIR"
    {
      echo "forge-dev: isolated runtime in $FORGE_DEV_DIR"
      echo "forge-dev: GUI/devtools join it with:"
      echo "forge-dev:   export FORGE_SOCKET='$FORGE_SOCKET' FORGE_HOME='$FORGE_HOME'"
    } >&2
    RUST_LOG="${RUST_LOG:-forge=debug,daemon=debug,info}" \
      exec cargo run -p daemon --bin forge-daemon -- "${@:2}"
    ;;
  dump)
    exec cargo run -p daemon --bin forge-daemon -- dump --json
    ;;
  check)
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo test --workspace
    # The OpenCode plugin is TypeScript that OpenCode's Bun loads as it is.
    (cd crates/agents && bun install --frozen-lockfile && bun run check && bun test src)
    if [ "${2:-}" != "--root-only" ]; then
      RUSTUP_TOOLCHAIN="$(sed -n 's/^channel = "\(.*\)"/\1/p' apps/ui/rust-toolchain.toml)"
      export RUSTUP_TOOLCHAIN
      cargo fmt --manifest-path apps/ui/Cargo.toml --all -- --check
      cargo clippy --manifest-path apps/ui/Cargo.toml --all-targets -- -D warnings
      cargo test --manifest-path apps/ui/Cargo.toml
    fi
    ;;
  ui)
    # apps/ui is its own workspace on its own toolchain; rustup reads
    # rust-toolchain.toml from the cwd, not the manifest, so name it here.
    export RUSTUP_TOOLCHAIN
    RUSTUP_TOOLCHAIN="$(sed -n 's/^channel = "\(.*\)"/\1/p' apps/ui/rust-toolchain.toml)"
    manifest=(--manifest-path apps/ui/Cargo.toml)
    case "${2:-check}" in
      check)
        cargo fmt "${manifest[@]}" --all -- --check
        cargo clippy "${manifest[@]}" --all-targets -- -D warnings
        cargo test "${manifest[@]}"
        ;;
      run)
        exec cargo run "${manifest[@]}" --release -- "${@:3}"
        ;;
      build)
        cargo build "${manifest[@]}" --release "${@:3}"
        ;;
      *)
        echo "usage: scripts/dev ui {check|build [cargo args]|run [forge-ui args]}" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "usage: scripts/dev {daemon|check|dump|ui}" >&2
    exit 2
    ;;
esac
