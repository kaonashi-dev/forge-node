# Sourced by package-macos / package-linux.
# Puts the bun named in .bun-version first on PATH, fetching a copy if PATH's
# bun is a different build. Does not touch ~/.bun.
# `.bun-version` may be `latest` (CI / floating pin); that is resolved to a
# concrete GitHub release tag before download or equality checks.

forge_bun_version() {
  local bin="${1:-bun}"
  "$bin" -e 'process.stdout.write(String(process.versions.bun || ""))' 2>/dev/null || true
}

# Map a floating pin to bun-vX.Y.Z's X.Y.Z. Exact pins pass through.
forge_resolve_bun_pin() {
  local pin="$1" loc tag
  if [ "$pin" != "latest" ]; then
    printf '%s' "$pin"
    return 0
  fi
  require_cmd curl
  # releases/latest redirects to .../tag/bun-vX.Y.Z; url_effective is enough
  # without parsing the API JSON body.
  loc="$(curl -fsSL -o /dev/null -w '%{url_effective}' \
    "https://github.com/oven-sh/bun/releases/latest")" || return 1
  case "$loc" in
    */bun-v[0-9]*) tag="${loc##*/bun-v}" ;;
    *) return 1 ;;
  esac
  [ -n "$tag" ] || return 1
  printf '%s' "$tag"
}

forge_require_bun() {
  local pin current platform cache dest tmp archive url resolved
  pin="$(tr -d '[:space:]' < "$repo_root/.bun-version")"
  [ -n "$pin" ] || die ".bun-version is missing or empty"

  if [ "$pin" = "latest" ]; then
    resolved="$(forge_resolve_bun_pin "$pin")" \
      || die "failed to resolve bun latest from GitHub releases"
    note "resolved .bun-version latest -> $resolved"
    pin="$resolved"
  fi

  if command -v bun >/dev/null 2>&1; then
    current="$(forge_bun_version)"
    if [ "$current" = "$pin" ]; then
      return 0
    fi
    note "PATH bun is ${current:-unknown}; using $pin from .bun-version"
  fi

  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64|Darwin-aarch64) platform="darwin-aarch64" ;;
    Darwin-x86_64)               platform="darwin-x64" ;;
    Linux-x86_64)                platform="linux-x64" ;;
    Linux-aarch64|Linux-arm64)   platform="linux-aarch64" ;;
    *) die "no pinned bun build for $(uname -s) $(uname -m)" ;;
  esac

  cache="${XDG_CACHE_HOME:-$HOME/.cache}/forge-node/bun/$pin"
  dest="$cache/bun"
  if [ ! -x "$dest" ] || [ "$(forge_bun_version "$dest")" != "$pin" ]; then
    require_cmd curl
    require_cmd unzip
    archive="bun-${platform}.zip"
    url="https://github.com/oven-sh/bun/releases/download/bun-v${pin}/${archive}"
    note "fetching bun $pin ($platform)"
    tmp="$(mktemp -d)"
    if ! curl -fsSL "$url" -o "$tmp/$archive"; then
      rm -rf "$tmp"
      die "failed to download bun $pin from $url"
    fi
    if ! unzip -q "$tmp/$archive" -d "$tmp"; then
      rm -rf "$tmp"
      die "failed to unpack bun $pin"
    fi
    mkdir -p "$cache"
    if ! mv "$tmp/bun-${platform}/bun" "$dest"; then
      rm -rf "$tmp"
      die "failed to install bun $pin into $cache"
    fi
    chmod 755 "$dest"
    rm -rf "$tmp"
  fi

  PATH="$cache:$PATH"
  export PATH
  current="$(forge_bun_version)"
  [ "$current" = "$pin" ] \
    || die "bun ${current:-missing} is on PATH after pinning; expected $pin"
}
