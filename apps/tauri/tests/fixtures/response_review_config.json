{
  "ReviewConfig": {
    "default_preset": "standard",
    "presets": [
      {
        "id": "standard",
        "name": "Review the change",
        "detail": "Correctness, missing tests, and anything that would block a merge.",
        "tier": null
      },
      {
        "id": "deep",
        "name": "Deep review",
        "detail": "Reads the surrounding code too — design, edge cases, cost.",
        "tier": "apex"
      }
    ],
    "rules": [
      {
        "id": "pagos-idempotencia",
        "title": "Every charge is idempotent",
        "severity": "P1",
        "category": "logic",
        "scope": [
          "src/billing/**"
        ],
        "enabled": true
      }
    ],
    "errors": [
      "broken.md: `scope` is empty"
    ]
  }
}
