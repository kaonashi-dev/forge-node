{
  "name": "@forge-node/tauri",
  "version": "0.1.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "bun scripts/runtime.ts",
    "dev": "vite --port 1420",
    "build": "bun run typecheck && vite build && bun run bundle",
    "preview": "vite preview",
    "test": "bun run build:file-workbench && bun scripts/runtime.ts && vitest run && bun test",
    "typecheck": "bun run build:file-workbench && bun scripts/runtime.ts && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "check": "bun run build:file-workbench && bun run lint && bun run fmt:check && bun run test && bun run build",
    "codegen": "bun scripts/codegen-types.ts",
    "tokens": "bun scripts/generate-tokens.ts && oxfmt --write src/theme/tokens.css",
    "theme:fixture": "bun scripts/emit-theme-fixture.ts",
    "tauri": "tauri",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt:write": "oxfmt --write",
    "bundle": "bun scripts/check-bundle.ts",
    "build:file-workbench": "tsc -p packages/file-workbench/tsconfig.json",
    "predev": "bun run build:file-workbench"
  },
  "dependencies": {
    "@forge-node/file-workbench": "workspace:*",
    "@kobalte/core": "^0.13.13",
    "@tauri-apps/api": "^2.0.0",
    "lucide-solid": "^1.37.0",
    "mermaid": "12.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "1.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "bun": "1.4.1"
  },
  "packageManager": "bun@1.4.1",
  "trustedDependencies": [
    "esbuild"
  ]
}
