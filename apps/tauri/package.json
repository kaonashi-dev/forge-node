{
  "name": "@forge-node/tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "bun scripts/runtime.ts",
    "dev": "vite --port 1420",
    "build": "bun run typecheck && vite build && bun run bundle",
    "preview": "vite preview",
    "test": "bun scripts/runtime.ts && vitest run && bun test",
    "typecheck": "bun scripts/runtime.ts && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "check": "bun run lint && bun run fmt:check && bun run test && bun run build",
    "codegen": "bun scripts/codegen-types.ts",
    "tokens": "bun scripts/generate-tokens.ts && oxfmt --write src/theme/tokens.css",
    "theme:fixture": "bun scripts/emit-theme-fixture.ts",
    "tauri": "tauri",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt:write": "oxfmt --write",
    "bundle": "bun scripts/check-bundle.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@kobalte/core": "^0.13.13",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.0.0",
    "lucide-solid": "^1.37.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "1.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "bun": "1.4.1"
  },
  "packageManager": "bun@1.4.1",
  "trustedDependencies": [
    "esbuild"
  ]
}
