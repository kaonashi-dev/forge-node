{
  "$schema_comment": "Editor hooks. fmt-and-check runs after a write; it never blocks the turn.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/fmt-and-check.sh",
            "timeout": 180,
            "statusMessage": "fmt + cargo check of the touched crate…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./init.sh*)",
      "Bash(scripts/dev*)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo test*)",
      "Bash(cargo check*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git rev-parse*)",
      "Write",
      "Edit",
      "Skill"
    ],
    "deny": [
      "Bash(cargo publish*)"
    ]
  }
}
